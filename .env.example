# Copy to .env (used by `npm run worker` and `npm run dev`).

# Where the worker sends results: your Vercel URL, or http://localhost:3000 for local dev.
APP_URL=https://job-scrapping-nine.vercel.app

# Shared secret between the website and the worker. Set the SAME value in
# Vercel → Project → Settings → Environment Variables → WORKER_TOKEN.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WORKER_TOKEN=change-me

# Redis (set automatically on Vercel when you add Upstash Redis under Storage).
# Leave empty locally to use an in-memory store.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
