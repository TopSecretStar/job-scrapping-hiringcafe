{
  "manifest_version": 3,
  "name": "Job Scrapper Helper",
  "version": "1.3.0",
  "description": "Lets the Job Scrapper website search hiringcafe.com through your browser, without opening any tabs.",
  "minimum_chrome_version": "111",
  "host_permissions": ["https://hiringcafe.com/*", "https://*.hiringcafe.com/*", "https://hiring.cafe/*", "https://*.hiring.cafe/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://job-scrapping-nine.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
